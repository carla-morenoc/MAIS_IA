# ============================================================
# AegisRAG — Variables de Entorno
# Copiar a .env y ajustar valores antes de ejecutar
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=aegisrag
POSTGRES_PASSWORD=aegisrag_secret
POSTGRES_DB=aegisrag
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------- Qdrant ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ---------- FastAPI ----------
API_TITLE=AegisRAG
API_VERSION=0.1.0
API_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---------- Embeddings ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------- Ingestión ----------
UPLOAD_DIR=uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=50
QDRANT_COLLECTION=aegis_chunks

# ---------- Reranker ----------
RERANKER_MODEL=BAAI/bge-reranker-base
CRAG_RELEVANCE_THRESHOLD=0.35

# ---------- LLM ----------
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
OLLAMA_BASE_URL=http://localhost:11434
