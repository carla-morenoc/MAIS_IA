# ============================================================
# MAIS_IA — Variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# ============================================================

# ── API ──────────────────────────────────────────────────────
API_DEBUG=false

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=MAIS_IA
POSTGRES_PASSWORD=cambia_esto_en_produccion
POSTGRES_DB=MAIS_IA
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
# Opcional: contraseña de Redis (requirepass en redis.conf)
# Si se define, la URL del broker de Celery la incluirá automáticamente.
# REDIS_PASSWORD=tu_password_de_redis

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Opcional: API Key de Qdrant (para instancias Cloud o con auth habilitada)
# QDRANT_API_KEY=tu_api_key_de_qdrant

# ── LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...

# ── YouTube ───────────────────────────────────────────────────
YOUTUBE_CHANNEL_ID=UCoZWQl3d034u8OIqnEGEnXA

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── URL del Frontend en Producción (VPS) ──────────────────────
# En la VPS de OVH, descomenta la siguiente línea y pon tu IP o dominio
# NEXT_PUBLIC_API_URL=http://<IP_DE_TU_VPS>:8000
